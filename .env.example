# Optional environment variables

# Dev server port (default: 3002, set in .env.defaults)
# PORT=3002

# The address people use to reach this editor. Read per request; set it when
# Pascal is hosted outside localhost (Mint sign-in and agent links use it).
# PASCAL_PUBLIC_URL=https://pascal.example.com

# Self-hosting: the one password that unlocks this editor. Required on any host
# that is not loopback. See SETUP.md, "Self-hosting".
# PASCAL_ADMIN_PASSWORD=change-me

# Optional bearer token for agents and scripts calling /api/scenes.
# PASCAL_SCENE_API_TOKEN=change-me-too

# House Agent: a vision model supporting OpenAI-compatible Chat Completions tools.
# Put real credentials in .env.local, never commit them.
# PASCAL_AGENT_BASE_URL=https://api.openai.com/v1
# PASCAL_AGENT_MODEL=your-vision-model
# PASCAL_AGENT_API_KEY=
# PASCAL_AGENT_REASONING_EFFORT=auto

# Design Image Studio & generate_design_image (independent from chat credentials)
# PASCAL_IMAGE_BASE_URL=https://api.openai.com/v1
# PASCAL_IMAGE_MODEL=gpt-image-1
# PASCAL_IMAGE_API_KEY=
# PASCAL_IMAGE_API_MODE=auto

# Meshy text/image-to-3D for Items → My models. Set the key in .env.local.
# MESHY_API_KEY=
